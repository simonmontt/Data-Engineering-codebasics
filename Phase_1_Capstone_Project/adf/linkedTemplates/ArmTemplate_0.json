                "activities": [
                    {
                        "name": "Set_Run_Start_At",
                        "type": "SetVariable",
                        "dependsOn": [],
                        "policy": {
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "typeProperties": {
                            "variableName": "run_start_at",
                            "value": {
                                "value": "@utcnow()",
                                "type": "Expression"
                            }
                        }
                    },
                    {
                        "name": "Lookup_Control_Table",
                        "type": "Lookup",
