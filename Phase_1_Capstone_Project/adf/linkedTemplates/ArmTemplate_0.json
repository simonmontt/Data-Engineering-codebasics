                                                "dependsOn": [],
                                                "policy": {
                                                    "timeout": "0.12:00:00",
                                                    "retry": 0,
                                                    "retryIntervalInSeconds": 30,
                                                    "secureOutput": false,
                                                    "secureInput": false
                                                },
                                                "userProperties": [],
                                                "typeProperties": {
                                                    "dataset": {
                                                        "referenceName": "ds_adls_bronze_parquet",
                                                        "type": "DatasetReference",
                                                        "parameters": {
                                                            "table_name": "@item().table_name",
                                                            "folder_path": {
                                                                "value": "@concat(\n    'bronze/',\n    item().table_name,\n    '/ingest_date=',\n    formatDateTime(variables('run_start_at'),'yyyy-MM-dd')\n)",
                                                                "type": "Expression"
                                                            }
                                                        }
                                                    },
                                                    "logStorageSettings": {
                                                        "linkedServiceName": {
                                                            "referenceName": "ls_adls_atliq",
                                                            "type": "LinkedServiceReference"
                                                        }
                                                    },
                                                    "enableLogging": true,
                                                    "storeSettings": {
                                                        "type": "AzureBlobFSReadSettings",
                                                        "recursive": true,
                                                        "enablePartitionDiscovery": false
                                                    }
                                                }
                                            },
                                            {
                                                "name": "Copy_Incremental_Table",
