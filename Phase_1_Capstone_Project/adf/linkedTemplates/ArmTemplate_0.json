{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "atliqdatafactory"
        },
        "ls_azuresql_atliq_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'ls_azuresql_atliq'"
        },
        "ls_azuresql_atliq_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "atliqserver.database.windows.net"
        },
        "ls_azuresql_atliq_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "atliq_commerce"
        },
        "ls_azuresql_atliq_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "CloudSA6494686c"
        },
        "ls_adls_atliq_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://atliqstorage.dfs.core.windows.net/"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "[concat(parameters('factoryName'), '/ls_azuresql_atliq')]",
            "type": "Microsoft.DataFactory/factories/linkedServices",
            "apiVersion": "2018-06-01",
            "properties": {
                "annotations": [],
                "type": "AzureSqlDatabase",
